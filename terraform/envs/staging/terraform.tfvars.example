region                  = "us-east-1"
artifact_bucket_name    = "migration-tracker-staging-artifacts-1234567890"
github_repository       = "example-org/migration-tracker"
cluster_admin_role_arns = ["arn:aws:iam::111122223333:role/PlatformEngineers"]

# ---------------------------------------------------------------------------
# DEMO ONLY - do not do this in production.
# ---------------------------------------------------------------------------
# The Kubernetes API is private by default, so kubectl works only from inside
# the VPC. That is the correct posture: operators reach a production cluster
# over Direct Connect or VPN, never from a laptop on the internet.
#
# In a demo account there is no hybrid link, so the API is unreachable from
# anywhere. If you need kubectl for a short test, open it to your own address
# and only your own address:
#
#   MY_IP=$(curl -s https://checkip.amazonaws.com)
#   cat >> terraform.tfvars <<EOF
#   eks_endpoint_public_access       = true
#   eks_endpoint_public_access_cidrs = ["${MY_IP}/32"]
#   EOF
#
# Put those lines in terraform.tfvars, never in this file: terraform.tfvars is
# gitignored, this one is committed. 0.0.0.0/0 is rejected by a validation rule.
#
# Remove them when finished. Production sets eks_endpoint_public_access = false
# permanently, and a public Kubernetes API is exactly what a private endpoint
# exists to prevent.
